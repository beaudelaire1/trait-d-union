# Trait d'Union Studio — Coolify / OVH
# Copy values into Coolify > Application > Environment Variables.
# Never commit real secrets.

DJANGO_SETTINGS_MODULE=config.settings.coolify
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=traitdunion.studio,www.traitdunion.studio,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://traitdunion.studio,https://www.traitdunion.studio
CANONICAL_DOMAIN=traitdunion.studio
SITE_URL=https://traitdunion.studio

# Use the Internal URL generated by the Coolify PostgreSQL resource.
DATABASE_URL=
# Start with prefer on Coolify's private Docker network. Switch to require
# after PostgreSQL TLS is explicitly enabled.
DB_SSLMODE=prefer

# Keep the single-container footprint modest initially.
Q_WORKERS=1
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

BREVO_API_KEY=
DEFAULT_FROM_EMAIL=contact@traitdunion.studio
DEFAULT_FROM_NAME=Trait d'Union Studio
ADMIN_EMAIL=contact@traitdunion.studio
TASK_NOTIFICATION_EMAIL=contact@traitdunion.studio

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_FALLBACK_TIMEOUT_MS=2500
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

GA4_MEASUREMENT_ID=
SENTRY_DSN=

GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_REVIEWS_LANGUAGE=fr
PAGESPEED_API_KEY=

INVOICE_IBAN=
INVOICE_BIC=

# Reuse the current production Cloudinary credentials if media uploads are
# already stored there. Leaving these blank makes Django use local filesystem
# storage, which is not suitable for cutover unless media persistence/serving
# has been configured separately.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Optional first deployment only. Remove the password after the account exists.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=contact@traitdunion.studio
DJANGO_SUPERUSER_PASSWORD=
