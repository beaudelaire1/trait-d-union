;; Zone Cloudflare propre pour traitdunion.it
;; Importer avec "Proxy imported DNS records" desactive.
;; Cloudflare gere lui-meme le SOA et les NS de la zone.
;;
;; IMPORTANT : un import ne supprime pas les anciens enregistrements.
;; Modifier ou supprimer les anciens A, AAAA et CNAME de @ et www avant import.
;; Tous les enregistrements de messagerie doivent rester en DNS only.

$ORIGIN traitdunion.it.
$TTL 300

;; Web OVH / Coolify - Django effectue la redirection 301 vers .studio
traitdunion.it. 300 IN A 152.228.236.95 ; cf_tags=cf-proxied:false
www.traitdunion.it. 300 IN CNAME traitdunion.it. ; cf_tags=cf-proxied:false

;; Configuration automatique des clients mail Hostinger
autoconfig.traitdunion.it. 300 IN CNAME autoconfig.mail.hostinger.com. ; cf_tags=cf-proxied:false
autodiscover.traitdunion.it. 300 IN CNAME autodiscover.mail.hostinger.com. ; cf_tags=cf-proxied:false

;; Brevo DKIM
brevo1._domainkey.traitdunion.it. 3600 IN CNAME b1.traitdunion-it.dkim.brevo.com. ; cf_tags=cf-proxied:false
brevo2._domainkey.traitdunion.it. 3600 IN CNAME b2.traitdunion-it.dkim.brevo.com. ; cf_tags=cf-proxied:false

;; Hostinger DKIM
hostingermail-a._domainkey.traitdunion.it. 300 IN CNAME hostingermail-a.dkim.mail.hostinger.com. ; cf_tags=cf-proxied:false
hostingermail-b._domainkey.traitdunion.it. 300 IN CNAME hostingermail-b.dkim.mail.hostinger.com. ; cf_tags=cf-proxied:false
hostingermail-c._domainkey.traitdunion.it. 300 IN CNAME hostingermail-c.dkim.mail.hostinger.com. ; cf_tags=cf-proxied:false

;; Reception des e-mails Hostinger
traitdunion.it. 300 IN MX 5 mx1.hostinger.com.
traitdunion.it. 300 IN MX 10 mx2.hostinger.com.

;; Authentification et validations existantes
traitdunion.it. 3600 IN TXT "brevo-code:b78fc4ecad8e6beb4f2d818516dcba83"
traitdunion.it. 3600 IN TXT "google-site-verification=VXQWZHnhfdEfdgzEl7lvSLFi97aEX25PayYt_JvAJvw"
traitdunion.it. 300 IN TXT "v=spf1 include:_spf.mail.hostinger.com ~all"
_dmarc.traitdunion.it. 300 IN TXT "v=DMARC1; p=none"
