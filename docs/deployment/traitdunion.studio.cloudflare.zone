;; Zone Cloudflare propre pour traitdunion.studio
;; Importer avec "Proxy imported DNS records" desactive.
;; Cloudflare gere lui-meme le SOA et les NS de la zone.
;;
;; IMPORTANT : un import ne supprime pas les anciens enregistrements.
;; Avant l'import, supprimer dans la zone existante :
;; - tous les NS vers *.verification-hold.dns-suspended.com ;
;; - tous les TXT contenant "This domain is under verification hold by Hostinger!" ;
;; - les anciens A de @, www et * vers 2.57.91.93 (ou 2.57.91.91).
;; Ne pas supprimer les MX, SPF, DMARC ni les trois CNAME DKIM Hostinger.

$ORIGIN traitdunion.studio.
$TTL 300

;; Web OVH / Coolify - DNS only pendant l'emission des certificats TLS
traitdunion.studio. 300 IN A 152.228.236.95 ; cf_tags=cf-proxied:false
www.traitdunion.studio. 300 IN CNAME traitdunion.studio. ; cf_tags=cf-proxied:false

;; Hostinger Email - DKIM (toujours DNS only)
hostingermail-a._domainkey.traitdunion.studio. 300 IN CNAME hostingermail-a.dkim.mail.hostinger.com. ; cf_tags=cf-proxied:false
hostingermail-b._domainkey.traitdunion.studio. 300 IN CNAME hostingermail-b.dkim.mail.hostinger.com. ; cf_tags=cf-proxied:false
hostingermail-c._domainkey.traitdunion.studio. 300 IN CNAME hostingermail-c.dkim.mail.hostinger.com. ; cf_tags=cf-proxied:false

;; Hostinger Email - reception
traitdunion.studio. 300 IN MX 5 mx1.hostinger.com.
traitdunion.studio. 300 IN MX 10 mx2.hostinger.com.

;; Hostinger Email - authentification
traitdunion.studio. 300 IN TXT "v=spf1 include:_spf.mail.hostinger.com ~all"
_dmarc.traitdunion.studio. 300 IN TXT "v=DMARC1; p=none"
